{
  "name": "unified-mcp",
  "version": "1.0.0",
  "description": "Unified MCP server combining weather, countries, Wikipedia, and Hacker News",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node dist/registry/generateCatalog.js",
    "start": "node dist/app.js",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/app.js",
    "start:http": "MCP_TRANSPORT=http node dist/app.js"
  },
  "keywords": ["mcp", "unified", "model-context-protocol"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "open-meteo-mcp": "*",
    "rest-countries-mcp": "*",
    "wikipedia-mcp": "*",
    "hacker-news-mcp": "*",
    "arxiv-mcp": "*",
    "open-library-mcp": "*",
    "nominatim-mcp": "*",
    "dictionary-mcp": "*",
    "frankfurter-mcp": "*",
    "usgs-earthquake-mcp": "*",
    "spacex-mcp": "*",
    "github-public-mcp": "*",
    "mdn-compat-mcp": "*",
    "datamuse-mcp": "*",
    "trivia-mcp": "*",
    "crossref-mcp": "*",
    "openalex-mcp": "*",
    "pubmed-mcp": "*",
    "wikidata-mcp": "*",
    "stackexchange-mcp": "*",
    "worldbank-mcp": "*",
    "openfda-mcp": "*",
    "musicbrainz-mcp": "*",
    "tvmaze-mcp": "*",
    "npm-registry-mcp": "*",
    "opensky-mcp": "*",
    "pokeapi-mcp": "*",
    "opennotify-mcp": "*",
    "worldtime-mcp": "*",
    "sunrise-sunset-mcp": "*",
    "semantic-scholar-mcp": "*",
    "openfoodfacts-mcp": "*",
    "jikan-mcp": "*",
    "swapi-mcp": "*",
    "pypi-mcp": "*",
    "gbif-mcp": "*",
    "careclinic-mcp": "*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
